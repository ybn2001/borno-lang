# 02_conditions.brn — if / elif / else and logical operators

dhori marks = 78;

jodi (marks >= 80) {
    dekhao("Grade: A+");
} nahole jodi (marks >= 70) {
    dekhao("Grade: A");
} nahole jodi (marks >= 60) {
    dekhao("Grade: B");
} nahole {
    dekhao("Fail");
}

dhori age = 20;
dhori has_id = sotti;

jodi (age >= 18 ebong has_id) {
    dekhao("Voting: allowed");
}
jodi (age < 13 ba age > 60) {
    dekhao("Discount ticket");
} nahole {
    dekhao("Regular ticket");
}
dekhao("na sotti =", na sotti);
