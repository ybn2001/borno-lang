# 03_loops.brn — while (jotokkhon) and for (chokro) loops

dekhao("Counting with jotokkhon:");
dhori i = 1;
jotokkhon (i <= 5) {
    dekhao("i =", i);
    i = i + 1;
}

dekhao("Multiplication table of 7 with chokro:");
chokro (dhori k = 1; k <= 10; k = k + 1) {
    dekhao("7 x", k, "=", 7 * k);
}

# Fibonacci — proves loops + variables together
dekhao("First 10 Fibonacci numbers:");
dhori x = 0;
dhori y = 1;
chokro (dhori n = 1; n <= 10; n = n + 1) {
    dekhao(x);
    dhori temp = x + y;
    x = y;
    y = temp;
}
