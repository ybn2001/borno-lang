# 05_showcase.brn — everything together: prime checker

dhori n = nao("Prime check korte ekta shongkha dao: ");

jodi (n < 2) {
    dekhao(n, "prime na");
} nahole {
    dhori is_prime = sotti;
    dhori d = 2;
    jotokkhon (d * d <= n ebong is_prime) {
        jodi (n % d == 0) {
            is_prime = mittha;
        }
        d = d + 1;
    }
    jodi (is_prime) {
        dekhao(n + " ekta prime shongkha!");
    } nahole {
        dekhao(n + " prime na.");
    }
}
