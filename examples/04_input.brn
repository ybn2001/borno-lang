# 04_input.brn — runtime input with nao()

dhori naam = nao("Tomar naam ki? ");
dekhao("Shagotom,", naam + "!");
dekhao("Tomar naam e", dorgho(naam), "ta okkhor ache.");

dhori num = nao("Ekta shongkha dao: ");
jodi (num % 2 == 0) {
    dekhao(num, "jor (even)");
} nahole {
    dekhao(num, "bijor (odd)");
}
dekhao("Er borgomul:", borgomul(poromman(num)));
